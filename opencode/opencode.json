{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "plan",
    "permission": {
        "webfetch": "allow",
        "websearch": "allow"
    },
    "agent": {
        "build": {
            "color": "#ff7480"
        },
        "plan": {
            "color": "#a3d79a"
        },
        "general": {
            "mode": "subagent",
            "model": "opencode/deepseek-v4-flash-free"
        },
        "explore": {
            "mode": "subagent",
            "model": "opencode/deepseek-v4-flash-free"
        },
        "scout": {
            "mode": "subagent",
            "model": "opencode/deepseek-v4-flash-free"
        }
    },
    "plugin": [
        "opencode-openai-codex-auth",
        [
            "/home/cassian/projects/js/opencode-ntfy/index.ts",
            {
                "topic": "cassian-opencode",
                "server": "https://ntfy.skrittle.net",
                "token": "{env:NTFY_TOKEN}",
            }
        ]
    ]
}
